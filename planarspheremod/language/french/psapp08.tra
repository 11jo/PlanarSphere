@0 = ~Salut ! Je suis l'assistant Scott ! Vous êtes venu admirer le travail incroyable du Professeur ?~ ~Salut ! Je suis l'assistant Scott ! Vous êtes venue admirer le travail incroyable du Professeur ?~
@1 = ~Euh... Non. Je ne faisais que passer.~
@2 = ~Oh. C'est dommage. Revenez nous voir !~
@3 = ~Oui. Je me demandais juste ce qui se passait.~
@4 = ~Oh, génial ! Eh bien, le Professeur travaillait justement à ouvrir un portail vers Sigil ! C'est incroyable ! C'est vraiment un génie !~
@5 = ~Euh... Oui. Vous êtes toujours comme ça ?~
@6 = ~Ça va marcher ?~
@7 = ~Bien sûr que oui ! C'est le Professeur ! Allez lui parler !~
@8 = ~Parler de quoi ? On me pose toujours cette question, mais je ne comprends pas.~
@9 = ~Laissez tomber. Je vais aller parler au Professeur.~
@10 = ~Oui ! Vous devriez ! Il est super !~
@11 = ~Hé ! Vous êtes de retour ! Avez-vous parlé au Professeur ?~
@12 = ~(reculer lentement)~
@13 = ~Non, pas encore.~
@14 = ~Oui. Et il a l'air complètement insensé.~
@15 = ~Au revoir !~
@16 = ~Oh. C'est dommage. Allez lui parler ! Il est super !~
@17 = ~Non ! Pas le Professeur ! Il est super ! Allez lui parler !~